<?xml version="1.0" encoding="utf-8"?>
<!-- Used when running with VSTest (UseVSTest=true). Keep in sync with testconfig.json (used with MTP). -->
<RunSettings>
	<RunConfiguration>
		<EnvironmentVariables>
			<!-- List of environment variables needed for bank tests -->
			<DOTNET_ENVIRONMENT>Development</DOTNET_ENVIRONMENT>
			<DOTNET_URLS>https://localhost:5501;http://localhost:5500</DOTNET_URLS>
		</EnvironmentVariables>
	</RunConfiguration>
</RunSettings>